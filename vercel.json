{
  "version": 2,
  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "/api/"
    },
    {
      "src": "^/$",
      "dest": "/static/login.html"
    },
    {
      "src": "^/login$",
      "dest": "/static/login.html"
    },
    {
      "src": "^/login.html$",
      "dest": "/static/login.html"
    },
    {
      "src": "^/editor$",
      "dest": "/static/index.html"
    },
    {
      "src": "^/index.html$",
      "dest": "/static/index.html"
    },
    {
      "src": "^/dashboard$",
      "dest": "/static/dashboard.html"
    },
    {
      "src": "^/dashboard.html$",
      "dest": "/static/dashboard.html"
    },
    {
      "src": "^/admin$",
      "dest": "/static/admin.html"
    },
    {
      "src": "^/admin.html$",
      "dest": "/static/admin.html"
    },
    {
      "src": "^/pricing$",
      "dest": "/static/pricing.html"
    },
    {
      "src": "^/pricing.html$",
      "dest": "/static/pricing.html"
    },
    {
      "src": "^/static/(.*)",
      "dest": "/static/"
    }
  ]
}